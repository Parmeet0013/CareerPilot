# OpenRouter (https://openrouter.ai/keys) - required for resume parsing,
# tailoring, job fit bullets, and mock interviews.
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=anthropic/claude-3.5-sonnet

# Cloud PostgreSQL (Neon or Supabase free tier). Leave empty to use local
# SQLite (backend/careerpilot.db) so the app runs offline.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
